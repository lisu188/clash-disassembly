# Mission 05 army march: stacks 0 and 1 (the real combat stacks; stack 4 is
# the builder crew per UnitType17_Builder) march to staging tiles beside the
# player-3 SW cluster. Waypoints on turn 1, per-turn manual resume (ready-bit
# quirk), arrival = zero-length retained paths for both stacks.
wait_log 60 mission_load_done selected=-1 a=5
wait_log 60 playgame_before_human_turn selected=-1 a=0 b=1

click 496 416 0.18 0.8 next-unit-select-stack0
wait_log 20 next_unit_selected selected=0
world_pan_viewport 43 55 80
click 320 240 0.18 0.8 set-waypoint-stack0-47-58
wait_log 20 move_order_track_result selected=0 a=47 b=58
click 320 240 0.05 2.0 confirm-waypoint-stack0
