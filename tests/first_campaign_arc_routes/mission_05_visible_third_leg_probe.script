include_script tests/first_campaign_arc_routes/mission_05_visible_second_leg_probe.script
# Observe a new banner after the action even when its artwork repeats.
mark_log_count turn3_banner1 tura1.gfx
mark_log_count turn3_banner2 tura2.gfx
mark_log_count turn3_banner3 tura3.gfx
mark_log_count turn3_banner4 tura4.gfx
mark_log_count turn3_banner5 tura5.gfx
mark_log_count turn3_banner6 tura6.gfx
mark_log_count turn3_banner7 tura7.gfx
include_script tests/first_campaign_arc_routes/mission_05_end_turn_ready.script
wait_log_marked_any 120 turn3_banner1 || turn3_banner2 || turn3_banner3 || turn3_banner4 || turn3_banner5 || turn3_banner6 || turn3_banner7
wait 1.0
click 320 240 0.12 0.65 dismiss-observed-turn3-banner
wait_log_any 120 playgame_before_human_turn selected=-1 a=0 b=3 || queen_proposal_dialog_enter
fail_unless_last_wait_log_any playgame_before_human_turn selected=-1 a=0 b=3
world_pan_viewport 59 46 80
click 320 240 0.18 1.0 select-stack4-at-63-49-turn3
wait_log 20 selected_stack_changed selected=4 a=63 b=49
world_save_slot 6 1.0 save-natural-turn3-refresh
wait_log 30 debug-save-written slot=6 ok=1
wait 5.0
screenshot mission05-visible-leg-turn3-refresh
nonblank mission05-visible-leg-turn3-refresh
fail_if_log mission05_failure_friendly_attack
# Original path: (62,49;4), (61,50;9), (60,51;14), (59,51;20).
click 64 368 0.18 0.8 preview-waypoint-59-51
wait_log 20 move_order_track_result selected=4 a=59 b=51 c=4
wait_log 20 unit_move_track_first selected=4 a=59 b=51 c=20
world_save_slot 5 1.0 save-third-leg-preview
wait_log 30 debug-save-written slot=5 ok=1
mark_log_count third_leg_move unit_move_after_path_state selected=4
mark_log_count third_leg_ap unit_move_after_path_ap selected=4 a=0 b=0 c=0
click 64 368 0.18 2.0 confirm-waypoint-59-51
wait_log_marked 60 third_leg_move
wait_log 20 unit_move_after_path_state selected=4 a=59 b=51 c=0
wait_log_marked 20 third_leg_ap
world_save_slot 4 1.0 save-third-leg-observed-stop
wait_log 30 debug-save-written slot=4 ok=1
wait 5.0
screenshot mission05-third-visible-leg
nonblank mission05-third-visible-leg
fail_if_log mission05_failure_friendly_attack
