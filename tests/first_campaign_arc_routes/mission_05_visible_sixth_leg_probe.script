include_script tests/first_campaign_arc_routes/mission_05_visible_fifth_leg_probe.script
# Original path: (54,53;6), (53,53;10), (52,53;14).
# Continue using the existing 15 AP; stack 4 remains selected after the prefix.
# Reused slots8/7 now hold this leg's preview/stop; slot9 retains the T5 base.
world_pan_viewport 51 50 80
click 128 240 0.18 0.8 preview-visible-waypoint-52-53
wait_log 20 move_order_track_result selected=4 a=52 b=53 c=3
wait_log 20 unit_move_track_first selected=4 a=52 b=53 c=14
mark_log_count sixth_preview_save debug-save-written slot=8 ok=1
world_save_slot 8 1.0 save-sixth-leg-preview
wait_log_marked 30 sixth_preview_save
mark_log_count sixth_leg_move unit_move_after_path_state selected=4
mark_log_count sixth_leg_ap unit_move_after_path_ap selected=4 a=1 b=0 c=0
click 128 240 0.18 2.0 confirm-visible-waypoint-52-53
wait_log_marked 60 sixth_leg_move
wait_log 20 unit_move_after_path_state selected=4 a=52 b=53 c=0
wait_log_marked 20 sixth_leg_ap
mark_log_count sixth_final_save debug-save-written slot=7 ok=1
world_save_slot 7 1.0 save-sixth-leg-observed-stop
wait_log_marked 30 sixth_final_save
world_move 127 240 0.5 align-cursor-with-original-sixth-final
wait 5.0
screenshot mission05-sixth-visible-leg
nonblank mission05-sixth-visible-leg
fail_if_log mission05_failure_friendly_attack
