# Extend the validated first Road checkpoint with a natural turn-7 refresh and
# exactly one more authentic Road segment. Keep this probe narrow so a failure
# distinguishes refresh from repeated Road-menu sequencing.
include_script tests/first_campaign_arc_routes/mission_05_first_road_probe.script

mark_log_count turn7_banner1 tura1.gfx
mark_log_count turn7_banner2 tura2.gfx
mark_log_count turn7_banner3 tura3.gfx
mark_log_count turn7_banner4 tura4.gfx
mark_log_count turn7_banner5 tura5.gfx
mark_log_count turn7_banner6 tura6.gfx
mark_log_count turn7_banner7 tura7.gfx
include_script tests/first_campaign_arc_routes/mission_05_end_turn_ready.script
wait_log_marked_any 120 turn7_banner1 || turn7_banner2 || turn7_banner3 || turn7_banner4 || turn7_banner5 || turn7_banner6 || turn7_banner7
wait 1.0
click 320 240 0.12 0.65 dismiss-observed-turn7-banner
wait_log_any 120 playgame_before_human_turn selected=-1 a=0 b=7 || queen_proposal_dialog_enter
fail_unless_last_wait_log_any playgame_before_human_turn selected=-1 a=0 b=7

world_pan_viewport 47 48 80
click 192 176 0.18 1.0 select-stack4-at-49-50-turn7
wait_log 20 selected_stack_changed selected=4 a=49 b=50
mark_log_count turn7_refresh_save debug-save-written slot=1 ok=1
world_save_slot 1 1.0 save-natural-turn7-refresh
wait_log_marked 30 turn7_refresh_save
wait 3.0
screenshot mission05-turn7-refresh-at-49-50
nonblank mission05-turn7-refresh-at-49-50

mark_log_count second_building_button action_widget_hit selected=4 a=480 b=432
mark_log_count second_building_ready builder_menu_enter selected=4 a=-1
click 496 448 0.18 1.0 open-building-menu-for-second-road
wait_log_marked 20 second_building_button
wait_log_marked 20 second_building_ready
wait 2.0
mark_log_count second_road_ready road_mode_enter selected=4
click 432 416 0.18 1.0 enter-road-mode-second-segment
wait_log_marked 20 second_road_ready
wait 2.0
screenshot mission05-road-mode-second-segment
nonblank mission05-road-mode-second-segment

mark_log_count second_road_move unit_move_after_path_state selected=4 a=48 b=50 c=0
mark_log_count second_road_ap unit_move_after_path_ap selected=4 a=16 b=0 c=0
click 160 176 0.18 2.0 build-second-road-segment-west
wait_log_marked 60 second_road_move
wait_log_marked 20 second_road_ap
mark_log_count second_road_save debug-save-written slot=0 ok=1
world_save_slot 0 1.0 save-after-second-road
wait_log_marked 30 second_road_save
world_move 160 176 0.5 align-second-road-cursor
wait 5.0
screenshot mission05-second-road-built
nonblank mission05-second-road-built
fail_if_log mission05_failure_friendly_attack
