# Mission 05 pan: use the WORKING next-unit selection (click 496 416 selected idx4 in
# the opening calibration) THEN world_pan_viewport. Pan needs a selected stack.
wait_log 60 mission_load_done selected=-1 a=5
wait_log 60 playgame_before_human_turn selected=-1 a=0 b=1
