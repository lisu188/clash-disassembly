# Mission 05 pan (mission_04 pattern): select a stack via platform_up FIRST, then
# world_pan_viewport toward player 3. mission_04 datum: stack@tile(41,50) -> view(47,65).
# mission_05 datum: tile(71,44) -> view(left67,top42). Sweep toward player-3 (~42,55).
wait_log 60 mission_load_done selected=-1 a=5
wait_log 60 playgame_before_human_turn selected=-1 a=0 b=1
# select a player-0 stack (screen ~300,250 == tile 71,44 in start view)
platform_up 300 250 0.80 select-p0-stack
wait 2.0
click 320 240 0.18 0.6 baseline-after-select
wait 1.0
# pan toward player-3 region; harness arrow-keys until it reaches the target
world_pan_viewport 40 55 260
click 320 240 0.18 0.6 probe-P-40-55
wait 0.8
click 200 300 0.18 0.6 probe-P2
wait 0.8
click 440 180 0.18 0.6 probe-P3
wait 0.8
screenshot mission05-pan-40-55
nonblank mission05-pan-40-55
