# Mission 02 direct repair probe: select Alan's main stack near the start,
# pan to Treg Rock, and issue an authentic enemy-castle click.
wait_log 60 mission_load_done selected=-1 a=2
wait_log 60 playgame_before_human_turn
nonblank mission02-start

# Initial stacks sit under the minimap overlay. Use the recovered Next Unit
# widget instead of a direct tile click; stack 1 is the first active stack with AP.
click 496 416 0.22 0.8 next-unit-main-stack
wait_log 20 next_unit_selected selected=1 a=98 b=25

# Stage the long march instead of asking the 100-slot path buffer to hold the
# entire route to Treg Rock at once. The direct castle path's raw waypoints
# include (89,45), so use that first route-backed waypoint.
click 570 107 0.18 0.8 minimap-waypoint-89-45
wait_log 20 minimap_update selected=1 a=84 b=41

# With left=84 top=41, waypoint (89,45) is under roughly (352,272).
# The window-local click lands one pixel high/left, so request x=353/y=273.
click 353 273 0.18 2.0 click-waypoint-89-45
wait_log 30 tile_input cursor=353,272 tile=89,45
wait_log 30 move_order_track_result selected=1 a=89 b=45
