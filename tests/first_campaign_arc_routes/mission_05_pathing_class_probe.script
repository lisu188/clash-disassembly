# Mission 05 pathing-class probe: can each player-0 stack path to the proven
# builder-reachable tile (47,58)? Sets the same waypoint from stack 1
# (type-5 cavalry lead) and stack 5 (type-1 light infantry pair) and records
# the move_order_track_result path lengths (c=-1 vs c=N) as evidence for the
# movement-class gate hypothesis (builders path, heavies do not).
wait_log 60 mission_load_done selected=-1 a=5
wait_log 60 playgame_before_human_turn selected=-1 a=0 b=1

click 496 416 0.18 0.8 next-unit-a
click 496 416 0.18 0.8 next-unit-select-stack1
wait_log 20 next_unit_selected selected=1
world_pan_viewport 43 55 80
click 320 240 0.18 0.8 waypoint-stack1-47-58
wait_log 20 move_order_track_result selected=1 a=47 b=58
screenshot mission05-pathprobe-stack1

click 496 416 0.18 0.55 next-unit-b
click 496 416 0.18 0.55 next-unit-c
click 496 416 0.18 0.55 next-unit-d
click 496 416 0.18 0.8 next-unit-select-stack5
wait_log 20 next_unit_selected selected=5
click 320 240 0.18 0.8 waypoint-stack5-47-58
wait_log 20 move_order_track_result selected=5 a=47 b=58
screenshot mission05-pathprobe-stack5
