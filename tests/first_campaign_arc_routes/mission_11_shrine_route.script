# Mission 11 shrine route (v2): march to (3,44) adjacent to the cult place,
# then click (2,44) to ENTER it (a religious site click = enter, not march,
# so the march must target an adjacent tile). pan(0,41): (3,44)=screen(240,240),
# (2,44)=screen(160,240). Per-turn resume via world_select_stack 0.
wait_log 60 mission_load_done selected=-1 a=11
wait 3.0
screenshot mission11-start
nonblank mission11-start

mark_log_count sel0_t1 selected_stack_changed selected=0
world_select_stack 0 0.6 select-idx-t1
wait_log_marked 20 sel0_t1
world_pan_viewport 0 41 120
click 240 240 0.18 1.0 waypoint-adj-3-44
wait_log 20 move_order_track_result selected=0 a=3 b=44
click 240 240 0.05 2.0 confirm-waypoint
wait_log 60 unit_move_after_path_state selected=0
screenshot mission11-t1-moved

# --- turn 2: resume march to (3,44) ---
click 500 2 0.18 1.0 end-turn-1
wait 4.0
click 320 240 0.12 0.65 skip-1-1
click 320 240 0.12 0.65 skip-1-2
click 320 240 0.12 0.65 skip-1-3
click 320 240 0.12 0.65 skip-1-4
wait_log 120 playgame_before_human_turn selected=-1 a=1 b=2
mark_log_count sel0_t2 selected_stack_changed selected=0
world_select_stack 0 0.6 select-idx-t2
wait_log_marked 20 sel0_t2
world_pan_viewport 0 41 120
click 240 240 0.18 1.0 rewaypoint-t2
wait_log 20 move_order_track_result selected=0
click 240 240 0.05 2.0 confirm-t2
wait_log 60 unit_move_after_path_state selected=0
world_select_stack 0 0.6 reselect-for-enter
world_pan_viewport 0 41 40
click 160 240 0.18 2.0 try-enter-cult-2
wait 2.0

