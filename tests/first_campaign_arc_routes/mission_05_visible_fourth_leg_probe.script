mark_log_count turn4_banner7 tura7.gfx
include_script tests/first_campaign_arc_routes/mission_05_end_turn_ready.script
wait_log_marked_any 120 turn4_banner1 || turn4_banner2 || turn4_banner3 || turn4_banner4 || turn4_banner5 || turn4_banner6 || turn4_banner7
wait 1.0
click 320 240 0.12 0.65 dismiss-observed-turn4-banner
wait_log_any 120 playgame_before_human_turn selected=-1 a=0 b=4 || queen_proposal_dialog_enter
fail_unless_last_wait_log_any playgame_before_human_turn selected=-1 a=0 b=4
world_pan_viewport 55 48 80
click 320 240 0.18 1.0 select-stack4-at-59-51-turn4
wait_log 20 selected_stack_changed selected=4 a=59 b=51
world_save_slot 3 1.0 save-natural-turn4-refresh
wait_log 30 debug-save-written slot=3 ok=1
wait 5.0
screenshot mission05-visible-leg-turn4-refresh
nonblank mission05-visible-leg-turn4-refresh
# Original path costs22: (58,52;5), (57,52;11), (56,52;17), (55,53;22).
# Natural AP exhaustion stops at (56,52), retaining the final5-AP node.
click 64 368 0.18 0.8 preview-waypoint-55-53
wait_log 20 move_order_track_result selected=4 a=55 b=53 c=4
wait_log 20 unit_move_track_first selected=4 a=55 b=53 c=22
world_save_slot 2 1.0 save-fourth-leg-preview
wait_log 30 debug-save-written slot=2 ok=1
mark_log_count fourth_leg_move unit_move_after_path_state selected=4
click 64 368 0.18 2.0 confirm-waypoint-55-53
wait_log_marked 60 fourth_leg_move
wait_log 20 unit_move_stop_ap selected=4 a=3 b=5 c=1
wait_log 20 unit_move_after_path_state selected=4 a=56 b=52 c=1
wait_log 20 unit_move_after_path_ap selected=4 a=3 b=0 c=0
world_save_slot 1 1.0 save-fourth-leg-observed-stop
wait_log 30 debug-save-written slot=1 ok=1
wait 5.0
