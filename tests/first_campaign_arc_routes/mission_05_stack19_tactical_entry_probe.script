# widget turn loop, screenshot). No exchanges are attempted yet; squad
# choreography is authored from this probe's evidence.
include_script tests/first_campaign_arc_routes/mission_05_multiturn_march_probe.script

# --- turn 10: refresh AP, reselect stack 4 ---------------------------------
