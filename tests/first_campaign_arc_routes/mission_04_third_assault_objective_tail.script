mark_log_count third_assault_14_3_attack_complete battle_attack_return selected={selected_unit} a=9 b=0
battle_click_until_marked 384 240 4 2.0 16 third_assault_14_3_defeated third_assault_14_3_attack_complete third-assault-attack-defender-14-3

mark_log_count third_assault_occupy_14_3 battle_move_execute_return selected={selected_unit} a=14 b=3
battle_click 384 240 4 2.0 third-assault-occupy-defeated-14-3
wait_log_marked 60 third_assault_occupy_14_3
