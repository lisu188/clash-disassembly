nonblank mission04-third-assault-occupy-14-3

mark_log_count third_assault_14_2_defeated battle_attack_return selected={selected_unit} a=11 b=0 c=1
mark_log_count third_assault_14_2_attack_complete battle_attack_return selected={selected_unit} a=11 b=0
mark_log_count third_assault_battle_return unit_attack_building_battle_return selected=0 a=1 b=0 c=0
mark_log_count third_assault_objective_complete mission_objective_complete
battle_click_until_marked 384 176 4 2.0 16 third_assault_14_2_defeated third_assault_14_2_attack_complete third-assault-attack-final-defender-14-2

