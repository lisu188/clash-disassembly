# The runtime/mission-route test harness is bash + python. On Windows checkouts,
# core.autocrlf rewrites these to CRLF, which makes WSL bash fail with
# "set: pipefail: invalid option name" (a trailing \r on `set -euo pipefail`)
# and breaks python route/script parsing — so the mission harness cannot run.
# The blobs are already LF; these rules stop autocrlf from mangling them on
# checkout, making the harness runnable in a Windows + WSL checkout.
*.sh       text eol=lf
*.py       text eol=lf
*.script   text eol=lf
*.env      text eol=lf
*.gdb      text eol=lf

# Source and review metadata also cross Windows/WSL Git boundaries. Keep the
# same bytes in both clients so autostash cannot create whole-file conflicts.
# auto leaves existing CRLF blobs alone; do not mass-renormalize old evidence.
*.c        text=auto eol=lf
*.cpp      text=auto eol=lf
*.h        text=auto eol=lf
*.cmake    text=auto eol=lf
CMakeLists.txt text=auto eol=lf
*.md       text=auto eol=lf
*.json     text=auto eol=lf
*.yml      text=auto eol=lf
*.yaml     text=auto eol=lf
*.toml     text=auto eol=lf
.gitattributes text=auto eol=lf
.gitignore text=auto eol=lf

# Large generated reference dumps: never normalize line endings (avoid churn).
*.asm      -text
*.map      -text
